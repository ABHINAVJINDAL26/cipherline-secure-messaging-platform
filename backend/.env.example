# Backend Production Environment Variables
# Copy this file to .env and fill in real values

# PostgreSQL connection string (from Supabase/Railway/Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Your deployed frontend URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app
